# ============================================
# 시니피에(Signifié) 환경 변수 설정
# 이 파일을 .env로 복사 후 실제 값을 입력하세요
# cp .env.example .env
# ============================================

# ----- AWS Bedrock 설정 -----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# 대회/워크숍 계정의 임시 자격증명이면 세션 토큰도 입력 (IAM 사용자 키면 비워두기)
AWS_SESSION_TOKEN=
# Bedrock 모델 ID (Anthropic SDK Bedrock Mantle 클라이언트 기준)
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_EFFORT=low
# 임베딩 모델 ID
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ----- Vector DB 설정 -----
# chromadb 또는 faiss 중 선택
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=./data/vectorstore

# ----- 공공데이터 API 설정 -----
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# ----- 앱 설정 -----
APP_ENV=development
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
